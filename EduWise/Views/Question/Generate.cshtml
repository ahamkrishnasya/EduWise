@model List<EduWise.Models.PdfFile>
@{
    ViewData["Title"] = "Generate Quiz";
}

<h2>Generate Quiz from PDF</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form method="post" asp-action="Generate">
    <div class="form-group">
        <label>Select PDF:</label>
        <select name="pdfId" class="form-control" required>
            <option value="">-- Select PDF --</option>
            @foreach (var pdf in Model)
            {
                <option value="@pdf.Id">@pdf.FileName</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Generate Quiz</button>
</form>
