@model IEnumerable<EduWise.Models.PdfFile>
@{
    ViewData["Title"] = "PDF Library";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Available PDFs</h2>
<a href="/Pdf/Upload" class="btn btn-success mb-3">Upload New PDF</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>File Name</th>
            <th>Uploaded</th>
            <th>View</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pdf in Model)
        {
            <tr>
                <td>@pdf.FileName</td>
                <td>@pdf.UploadedAt</td>
                <td><a href="@pdf.FilePath" target="_blank" class="btn btn-sm btn-primary">Open</a></td>
            </tr>
        }
    </tbody>
</table>
